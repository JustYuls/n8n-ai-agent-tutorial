{
  "name": "Daily Weather Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1,
              "triggerAtHour": 7,
              "triggerAtMinute": 0
            }
          ]
        }
      },
      "id": "c6000000-0000-4000-8000-000000000001",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "url": "https://api.open-meteo.com/v1/forecast",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "latitude",
              "value": "14.6042"
            },
            {
              "name": "longitude",
              "value": "120.9822"
            },
            {
              "name": "daily",
              "value": "temperature_2m_max,temperature_2m_min,precipitation_probability_max"
            },
            {
              "name": "forecast_days",
              "value": "1"
            },
            {
              "name": "timezone",
              "value": "Asia/Manila"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000000-0000-4000-8000-000000000002",
      "name": "Get weather",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        220,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 1500
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c6000000-0000-4000-8000-000000000011",
              "name": "city",
              "value": "Manila",
              "type": "string"
            },
            {
              "id": "c6000000-0000-4000-8000-000000000012",
              "name": "max",
              "value": "={{ $json.daily.temperature_2m_max[0] }}",
              "type": "number"
            },
            {
              "id": "c6000000-0000-4000-8000-000000000013",
              "name": "min",
              "value": "={{ $json.daily.temperature_2m_min[0] }}",
              "type": "number"
            },
            {
              "id": "c6000000-0000-4000-8000-000000000014",
              "name": "rain",
              "value": "={{ $json.daily.precipitation_probability_max[0] }}",
              "type": "number"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000000-0000-4000-8000-000000000003",
      "name": "Weather facts",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Weather today in {{ $json.city }}: high {{ $json.max }} degrees Celsius, low {{ $json.min }} degrees Celsius, chance of rain {{ $json.rain }} percent. Write ONE short sentence of advice for a student who is going out. Use simple English. Use only the numbers given here.",
        "batching": {}
      },
      "id": "c6000000-0000-4000-8000-000000000004",
      "name": "Advice",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        660,
        200
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "model": "llama3.2:3b",
        "options": {}
      },
      "id": "c6000000-0000-4000-8000-000000000005",
      "name": "Ollama Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        680,
        420
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c6000000-0000-4000-8000-000000000015",
              "name": "text",
              "value": "Advice is not available right now (the AI did not answer).",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000000-0000-4000-8000-000000000006",
      "name": "Fallback advice",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        880,
        380
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c6000000-0000-4000-8000-000000000016",
              "name": "line",
              "value": "={{ [$now.setZone('Asia/Manila').toFormat('yyyy-LL-dd HH:mm:ss'), $('Weather facts').item.json.city, $('Weather facts').item.json.max, $('Weather facts').item.json.min, $('Weather facts').item.json.rain, $json.text].map(v => '\"' + String(v).replaceAll('\"', '\"\"').replaceAll('\\n', ' ') + '\"').join(',') + '\\n' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "c6000000-0000-4000-8000-000000000007",
      "name": "Build line",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "line",
        "options": {}
      },
      "id": "c6000000-0000-4000-8000-000000000008",
      "name": "Convert to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.2,
      "position": [
        1320,
        200
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "C:/Users/YOUR-NAME/.n8n-files/daily-weather.csv",
        "options": {
          "append": true
        }
      },
      "id": "c6000000-0000-4000-8000-000000000009",
      "name": "Write File to Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1540,
        200
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get weather",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get weather": {
      "main": [
        [
          {
            "node": "Weather facts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Weather facts": {
      "main": [
        [
          {
            "node": "Advice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Advice",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Advice": {
      "main": [
        [
          {
            "node": "Build line",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Fallback advice",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fallback advice": {
      "main": [
        [
          {
            "node": "Build line",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build line": {
      "main": [
        [
          {
            "node": "Convert to File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert to File": {
      "main": [
        [
          {
            "node": "Write File to Disk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "Err05Logger000001",
    "timezone": "Asia/Manila"
  }
}