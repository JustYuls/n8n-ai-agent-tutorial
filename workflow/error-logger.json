{
  "name": "Error logger",
  "nodes": [
    {
      "parameters": {},
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b2000000-0000-4000-8000-000000000002",
              "name": "line",
              "value": "={{ [$now.setZone('Asia/Manila').toFormat('yyyy-LL-dd HH:mm:ss'), $json.workflow.name, $json.execution.lastNodeExecuted, $json.execution.error.message].map(v => '\"' + String(v).replaceAll('\"', '\"\"').replaceAll('\\n', ' ') + '\"').join(',') + '\\n' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Build line",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        220,
        200
      ]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "line",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Convert to File",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.2,
      "position": [
        440,
        200
      ]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "C:/Users/YOUR-NAME/.n8n-files/errors-log.csv",
        "options": {
          "append": true
        }
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Write File to Disk",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        660,
        200
      ]
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Build line",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build line": {
      "main": [
        [
          {
            "node": "Convert to File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Convert to File": {
      "main": [
        [
          {
            "node": "Write File to Disk",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}