{
  "name": "Study Tracker (Excel): n8n AI agent logs every chat to a CSV file",
  "nodes": [
    {
      "parameters": {
        "public": true,
        "mode": "webhook",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chatTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        0
      ],
      "name": "When chat message received"
    },
    {
      "parameters": {
        "options": {
          "systemMessage": "Ikaw si Reviewer Buddy. Sumagot sa Taglish. Kung math ang tanong, laging gamitin ang calculator tool at huwag mag-hula; ibigay sa calculator ang BUONG expression sa isang tawag. Mga formula: final price = presyo * (1 - discount/100) * (1 + vat/100). Ang X% ng N ay N * X / 100. Kung hindi math ang tanong, huwag gumamit ng calculator; sumagot nang normal."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        352,
        0
      ],
      "name": "AI Agent"
    },
    {
      "parameters": {
        "model": "llama3.2:3b",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        232,
        232
      ],
      "name": "Ollama Chat Model"
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.toolCalculator",
      "typeVersion": 1,
      "position": [
        488,
        232
      ],
      "name": "Calculator"
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.toolWikipedia",
      "typeVersion": 1,
      "position": [
        616,
        232
      ],
      "name": "Wikipedia"
    },
    {
      "parameters": {},
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.4,
      "position": [
        360,
        232
      ],
      "name": "Simple Memory"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1beb01d-d905-4857-8e52-42b33c446a8b",
              "name": "line",
              "value": "={{ [$now.setZone('Asia/Manila').toFormat('yyyy-LL-dd HH:mm'), $('When chat message received').item.json.chatInput, $json.output].map(v => '\"' + String(v).replaceAll('\"', '\"\"').replaceAll('\\n', ' ') + '\"').join(',') + '\\n' }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        816,
        0
      ],
      "name": "Edit Fields"
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "line",
        "options": {}
      },
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.2,
      "position": [
        1040,
        0
      ],
      "name": "Convert to File"
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "C:/Users/YOUR-NAME/.n8n-files/study-log.csv",
        "options": {
          "append": true
        }
      },
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        1264,
        0
      ],
      "name": "Read/Write Files from Disk"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "fca16336-e7b2-422d-8737-e8a80f4cf5cd",
              "name": "output",
              "value": "={{ $('AI Agent').item.json.output }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        1488,
        0
      ],
      "name": "Edit Fields1"
    }
  ],
  "connections": {
